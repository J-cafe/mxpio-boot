# Whether to open mock
VITE_USE_MOCK = false

# public path
VITE_PUBLIC_PATH = /

# Basic interface address SPA
VITE_GLOB_API_URL=/basic-api

# File upload address， optional
VITE_GLOB_UPLOAD_URL=/basic-api/file/upload

# Interface prefix
VITE_GLOB_API_URL_PREFIX=

# 开启统一认证，feishu | wechat | dingtalk | oauth | MSAL，为空时：采用本地账号密码认证
# 开启认证后，需要在setting中配置ssoLoginUrl、ssoClientId等相关参数
VITE_GLOB_APP_SSO =