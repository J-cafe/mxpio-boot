{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@mxpio/ts-config/vue-app.json",
  "include": [
    "src"
  ],
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "declaration": false,
    "declarationMap": false
  },
  "vueCompilerOptions": {
    "target": 3,
    "skipTemplateTypecheck": false
  }
}